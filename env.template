# ==== Key Connector (TEST) — /app/data/env ====
# Après modification : redémarrer l'app dans Cloudron.

# Origine du web vault autorisée en CORS (URL de l'app Vaultwarden KC, sans slash final)
KC_CORS_ALLOWED_ORIGINS=https://CHANGEME-vaultkc.ixapack.io

# --- Option A (recommandée) : clé publique statique ---
# 1. Dans le Terminal de l'app Vaultwarden KC :
#      openssl rsa -in /app/data/rsa_key.pem -pubout
# 2. Coller le résultat dans /app/data/identity.pub.pem de CETTE app
# 3. Renseigner l'issuer (même valeur que le DOMAIN de Vaultwarden + "|login") :
KC_JWT_ISSUER="https://CHANGEME-vaultkc.ixapack.io|login"

# --- Option B : découverte OIDC (nécessite que le KC joigne Vaultwarden) ---
# Utilisée seulement si /app/data/identity.pub.pem n'existe pas.
KC_IDENTITY_AUTHORITY=https://CHANGEME-vaultkc.ixapack.io/identity

# Clé de chiffrement : laisser vide = générée dans /app/data (TEST).
# KC_ENCRYPTION_KEY=

RUST_LOG=key_connector=info,tower_http=info
