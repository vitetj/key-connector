# ==== Vaultwarden KC (TEST) — /app/data/env ====
# Après modification : redémarrer l'app dans Cloudron.

# --- Admin (/admin) : générer avec  openssl rand -base64 48
ADMIN_TOKEN=CHANGEME

SIGNUPS_ALLOWED=false

# --- SSO Entra ID ---
SSO_ENABLED=true
# Endpoint v2 obligatoire, sans slash final
SSO_AUTHORITY=https://login.microsoftonline.com/CHANGEME-TENANT-ID/v2.0
SSO_CLIENT_ID=CHANGEME
SSO_CLIENT_SECRET=CHANGEME
# offline_access requis sinon Entra ne renvoie pas de refresh_token
SSO_SCOPES="email profile offline_access"
SSO_PKCE=true
SSO_SIGNUPS_MATCH_EMAIL=true
# Admins/owners gardent un mot de passe maître (KEY_CONNECTOR_EXEMPT_ADMINS) -> SSO_ONLY possible
SSO_ONLY=true
# Si l'inscription SSO est bloquée pour "email non vérifié" côté Entra :
# SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=true
# (dans ce cas passe SSO_SIGNUPS_MATCH_EMAIL=false, risque de prise de compte)

# --- Key Connector ---
KEY_CONNECTOR_ENABLED=true
KEY_CONNECTOR_URL=https://CHANGEME-keyconnector.ixapack.io
KEY_CONNECTOR_ORG_NAME="Ixapack TEST"
# true = owners/admins NE sont PAS enrôlés et gardent un mot de passe maître (recommandé)
KEY_CONNECTOR_EXEMPT_ADMINS=true

LOG_LEVEL=info
# Debug SSO si besoin :
# LOG_LEVEL=info,vaultwarden::sso=debug
